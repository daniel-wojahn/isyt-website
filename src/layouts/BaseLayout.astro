---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'International Seminar of Young Tibetologists',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/2020/12/lion-150x150.png" />
    <title>{title}</title>
  </head>
  <body id="top" class={bodyClass}>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
